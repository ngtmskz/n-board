# ローカル開発用（Firebase Local Emulator Suite）。本物の Firebase には接続しない。
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nboard.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-nboard
VITE_FIREBASE_APP_ID=demo-app-id
# ログインを許可するメールアドレスのドメイン（カンマ区切り）
VITE_ALLOWED_DOMAINS=example.com
