# どの環境でも使う設定。環境ごとに変えたいときは .env.development / .env.production で上書きする。
VITE_APP_NAME=N-Board
# 画面に出す説明。言語ごとに書く（空なら初期値を使う）
VITE_APP_TAGLINE_JA=みんなのホワイトボード
VITE_APP_TAGLINE_EN=Whiteboard for everyone
# 「このサービスについて」に出す、ご意見・ご要望の連絡先（空なら出さない）
VITE_APP_CONTACT=
# 「このサービスについて」のいちばん下に「Powered by N-Board」を出すか（false で消す）
VITE_SHOW_POWERED_BY=true
